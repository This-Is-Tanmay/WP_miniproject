# DriveEase Car Rental — Apache Configuration
Options -Indexes

# Charset
AddDefaultCharset UTF-8

# PHP settings
php_value session.cookie_httponly 1
php_value session.use_strict_mode 1

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct access to includes & ajax from browser (only allow PHP internal)
<FilesMatch "\.(sql|md|log|json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json
</IfModule>

# Browser caching for assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg    "access plus 1 month"
    ExpiresByType image/jpeg   "access plus 1 month"
    ExpiresByType image/png    "access plus 1 month"
    ExpiresByType image/webp   "access plus 1 month"
    ExpiresByType text/css     "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
